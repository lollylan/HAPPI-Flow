{
  "name": "haeppi-flow",
  "version": "2.0.0",
  "private": true,
  "description": "Dienstplanung fuer die Hausarztpraxis - lokal, offline, mehrbenutzerfaehig",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n shared,server,client -c gray,blue,green \"npm:dev:shared\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:shared": "tsc -b packages/shared --watch --preserveWatchOutput",
    "dev:server": "npm run dev --workspace @haeppi/server",
    "dev:client": "npm run dev --workspace @haeppi/client",
    "build": "tsc -b && npm run build --workspace @haeppi/client",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "tsc -b && tsc --noEmit -p apps/client/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env TZ=Europe/Berlin vitest run",
    "test:watch": "cross-env TZ=Europe/Berlin vitest",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
