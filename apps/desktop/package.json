  },
  "dependencies": {
    "@haeppi/shared": "*",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "^26.8.1"
  }
}
