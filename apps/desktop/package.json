{
  "name": "@haeppi/desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Windows-Huelle: startet den lokalen Server und zeigt die Oberflaeche.",
  "author": "Praxis",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "npm run build && node scripts/prepare-resources.mjs && electron .",
